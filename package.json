{
  "name": "european-monarchies-timeline",
  "version": "1.0.0",
  "description": "A source-backed interactive timeline of major European monarchies from 27 BCE through 2026.",
  "scripts": {
    "build": "npm run validate:data && npm run build:data",
    "build:data": "node scripts/build_site_data.js",
    "ingest:wikidata": "node scripts/ingest_wikidata.js",
    "serve": "python3 -m http.server 8000 --directory www",
    "test": "node --test tests/*.test.js && npm run validate:data",
    "validate:data": "node scripts/validate_data.js",
    "refresh:wikipedia": "node scripts/refresh_wikipedia.js",
    "report:data": "node scripts/validate_data.js --json",
    "validate:strict": "node scripts/validate_data.js --strict",
    "test:browser": "python3 -m http.server 8001 --bind 127.0.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielpradilla/european-monarchies-timeline.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/danielpradilla/european-monarchies-timeline/issues"
  },
  "homepage": "https://github.com/danielpradilla/european-monarchies-timeline#readme"
}
